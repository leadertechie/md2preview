{
  "name": "@leadertechie/md2preview",
  "version": "0.0.0",
  "description": "Renderer MFE: projects Markdown content into a layout and mounts its micro-frontends in a scoped container.",
  "type": "module",
  "main": "dist/md2preview.js",
  "module": "dist/md2preview.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mfe",
    "micro-frontend",
    "preview",
    "markdown",
    "web-component"
  ],
  "license": "MIT",
  "dependencies": {
    "@leadertechie/md2compose": "^0.1.0-alpha.5",
    "@leadertechie/md2html": "^0.1.0-alpha.27",
    "@leadertechie/md2interact": "^0.1.0-alpha.6"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  }
}
